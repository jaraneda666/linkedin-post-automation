    {
      "parameters": {
        "jsCode": "// Combina items RSS (con category) + entradas del log (isLogEntry=true)\nconst items = $input.all();\n\nconst logLinks = items\n  .filter(i => i.json.isLogEntry === true)\n  .map(i => i.json.Link);\n\nconst rssItems = items.filter(i => !i.json.isLogEntry);\n\nconst freshItems = rssItems.filter(i => !logLinks.includes(i.json.link));\n\nif (freshItems.length === 0) {\n  return [{ json: { found: false } }];\n}\n\nconst chosen = freshItems[Math.floor(Math.random() * freshItems.length)];\n\nreturn [{\n  json: {\n    found: true,\n    title: chosen.json.title || '',\n    link: chosen.json.link || '',\n    description: (chosen.json.contentSnippet || chosen.json.content || '').toString().substring(0, 500),\n    category: chosen.json.category || 'General'\n  }\n}];"
      },
